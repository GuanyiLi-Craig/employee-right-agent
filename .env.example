# Copy to .env only if you need to change something. Every default below works
# with no API key and no network.

# ---- ports (change these if something else on your machine owns them) -------
DASHBOARD_PORT=8000
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317

# ---- model ------------------------------------------------------------------
# stub-local is offline, deterministic and extractive, and is what CI uses. Any
# other value must be a hosted model id whose key is set below; a missing key
# falls back to the stub (loudly, at WARNING).
RIGHTS_MODEL=stub-local
# RIGHTS_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Let a model that supports it think before answering. Off by default and sent
# explicitly: DeepSeek's `thinking` parameter defaults to ENABLED, so omitting it
# buys reasoning tokens and a much slower first token without asking.
RIGHTS_THINKING=false

# Cap on the generated answer. The stub is extractive so it rarely approaches
# this; a hosted model will, and a runaway answer is a runaway output bill.
RIGHTS_MAX_ANSWER_CHARS=2000

# Override the OpenAI-compatible endpoint (a proxy, a self-hosted gateway).
# RIGHTS_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model the judge line is priced against. Empty = the serving model; set this if
# you judge with something cheaper than you serve with.
# RIGHTS_JUDGE_MODEL=

# ---- embedding (used by the ingest job; readers are pinned to the manifest) --
# Measured on the Employment Rights Act 2025, recall of the golden set's 30
# expected citations:
#   openai  (text-embedding-3-small)  100.0%   143ms/query   ~17s to index   ~1c
#   onnx    (all-MiniLM-L6-v2)         90.0%    53ms/query   60s to index   free
#   hashing (bag-of-words)             86.7%     2ms/query    3s to index   free
#
# `auto` tries onnx and falls back to hashing; it never selects a paid embedder.
# The eval datasets live per embedder under evals/datasets/, so changing this
# changes which golden set the gate reads -- and the index must be rebuilt.
#
# The code default is `auto`. This file pins `hashing` on purpose: it is the only
# one of the three that is bit-deterministic, which is what CI gates on and what
# makes a local run reproduce a CI result.
RIGHTS_EMBEDDER=hashing

# Push the judged scores to Phoenix as span annotations as well as attributes.
# Annotations aggregate and filter across a project, and show as running means in
# the project sidebar. Runs off the request path, so it costs no answer latency.
# Follows RIGHTS_TRACING unless set explicitly.
# RIGHTS_ANNOTATE_TRACES=true

# ---- retrieval and the refusal gate -----------------------------------------
RIGHTS_TOP_K=6
RIGHTS_SUFFICIENCY=0.45
RIGHTS_MAX_ATTEMPTS=2
RIGHTS_MAX_PARENT_CHARS=4000
RIGHTS_CONTEXT_BUDGET=6000
# Floor on a retrieved block before it is worth spending context on. Must stay
# below RIGHTS_CONTEXT_BUDGET -- the pair is validated at startup rather than
# discovered as an empty prompt.
RIGHTS_MIN_BLOCK_CHARS=400

# ---- artefacts --------------------------------------------------------------
# Chroma stores its index in SQLite, which fails with `disk I/O error` on some
# network and virtualised mounts. Point this at local disk.
RIGHTS_RUNS_DIR=./runs
RIGHTS_DATA_DIR=./data
# Which document to index. Unset means ./data/corpus.layout.txt, the generated
# Act -- offline, reproducible, and what the parser unit tests are written
# against. The real Act is the corpus the committed eval datasets were generated
# for, and reading it needs pdftotext (poppler) on PATH.
# RIGHTS_CORPUS=./data/corpus.layout.txt
# RIGHTS_CORPUS=./data/ukpga_20250036_en.pdf

# ---- audit record (hash-chained, one per decision) --------------------------
RIGHTS_AUDIT=true
# Retention has two boundaries and neither comes from Article 12: the AI Act's
# Articles 19/26(6) set a floor (appropriate to purpose, generally >= 6 months),
# and GDPR's storage-limitation principle sets no universal maximum but requires
# you to justify the period. Below the floor is refused at startup.
RIGHTS_RETENTION_DAYS=183
RIGHTS_TENANT=default
RIGHTS_ROLE=reader
RIGHTS_LAWFUL_BASIS=legitimate_interests

# ---- cost reporting ---------------------------------------------------------
# The monthly projection's volume assumption, reported next to the number.
RIGHTS_PROJECTION_RPD=50000
# The judge is an LLM call, so scoring every request materially increases the
# bill. This rate is what the cost panel's judge line is modelled at.
RIGHTS_JUDGE_SAMPLE_RATE=0.10
# Requests the latency and quality panels average over. Windowed on purpose: a
# cumulative percentile cannot move during an incident.
RIGHTS_PANEL_WINDOW=20

# ---- tracing ----------------------------------------------------------------
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=rights-rag-agent
RIGHTS_TRACING=true

# ---- demo security ----------------------------------------------------------
# Gates the endpoints that can erase or read the audit record: /api/job,
# /api/degraded, /api/chat/reset, /api/audit. Empty is fine on loopback; the
# server REFUSES to bind a non-loopback address without it. No default ships,
# because a shared secret in a committed file is a fake control.
# RIGHTS_DEMO_TOKEN=
# RIGHTS_DEMO_ALLOW_INSECURE=false
# Each chat is a thread and a billable model call.
RIGHTS_DEMO_MAX_CONCURRENT_CHATS=4

# Publish the container ports beyond loopback only on purpose, and only with a
# token set. See security/README.md.
# DASHBOARD_BIND=127.0.0.1
# PHOENIX_BIND=127.0.0.1

# ---- demo -------------------------------------------------------------------
RIGHTS_DEMO_HOST=127.0.0.1
RIGHTS_DEMO_PORT=8000
# Pay the first-request costs at startup instead of landing them on whoever asks
# the first question. A hosted model's first call pays TLS setup and an empty
# prompt cache: 10.5s TTFT against 0.8s warm.
RIGHTS_WARMUP=true
RIGHTS_DEGRADED=false
RIGHTS_LOG_LEVEL=INFO
RIGHTS_LOG_JSON=false
